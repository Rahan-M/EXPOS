int main(){
    decl
        int num, temp, sq;
    enddecl
    begin
        num=1;
        while(num<=100) do
            if((num%2)==0) then
                sq=num*num;
                temp=exposcall("Write", -2, sq);
            endif;
            num=num+1;
        endwhile;
        return 0;
    end
}