decl
    int isPrime(int num);
enddecl

int isPrime(int num){
decl
    int i, ans;
enddecl
begin
    i=2;
    ans=1;
    while(i<(num/2)) do
        if((num%i)==0) then
            ans=0;
            break;
        endif;
        i=i+1;
    endwhile;
    return ans;
end
}

int main()
{
decl
    int temp,num;
enddecl
begin
    num=1;
    breakpoint;
    while ( num <= 100 ) do
        if(isPrime(num)==1) then
            temp = exposcall ( "Write" , -2, num );
        endif;
        num = num + 1;
    endwhile;
    return 0;
end
}