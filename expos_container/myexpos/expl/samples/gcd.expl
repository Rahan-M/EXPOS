decl
    int gcd(int a, int b);
enddecl;

int gcd(int a, int b){
    decl
        int ans;
    enddecl

    if(a<b) then
        ans=gcd(b,a);
    else
        if(a%b == 0) then
            ans = b;
        else
            ans=gcd(b, a%b);
        endif;
    endif

    return ans;
}

int main(){
    decl
        int a, b, ans, temp;
    enddecl
    begin
        temp=exposcall("Read", -1, a);
        temp=exposcall("Read", -1, b);

        ans=gcd(a,b);
        temp=exposcall("Write", -2, ans);

        return 0;
    end
}