loadi(54, 67); // Module 7
loadi(55, 68);
loadi(69, 11); // IDLE PROGRAM
loadi(70, 12);

SP=82*512-1; // Physical address of kernel stack of idle program
// Sets up stack for calling boot module

call BOOT_MODULE;

// Idle process
PTBR=PAGE_TABLE_BASE;  //as PID of idle process is 0
PTLR=10;

//Library
[PTBR+0] = 63;
[PTBR+1] = "0100";
[PTBR+2] = 64;
[PTBR+3] = "0100";

//Heap
[PTBR+4] = -1;
[PTBR+5] = "0000";
[PTBR+6] = -1;
[PTBR+7] = "0000";

//Code
[PTBR+8] = 69;
[PTBR+9] = "0100";
[PTBR+10] = 70;
[PTBR+11] = "0100";
[PTBR+12] = -1;
[PTBR+13] = "0000";
[PTBR+14] = -1;
[PTBR+15] = "0000";

//Stack
[PTBR+16] = 81;
[PTBR+17] = "0110";
[PTBR+18] = -1;
[PTBR+19] = "0000";

// PROCESS_TABLE stores 28672 = 56 * 512
// IDLE PROCESS
[PROCESS_TABLE + 1] = 0; // PID
[PROCESS_TABLE + 4] = RUNNING; // STATUS
[PROCESS_TABLE + 11] = 82; // User area page number
[PROCESS_TABLE + 13] = 0; // Logical adress of user stack
[PROCESS_TABLE + 13] = 8 * 512; // Logical adress of user stack
[PROCESS_TABLE + 14] = PAGE_TABLE_BASE; // PTBR
[PROCESS_TABLE + 15] = 10; // PTLR
[81*512] = [69*512 + 1];
SP=8*512;

PTBR=PAGE_TABLE_BASE;
PTLR=10;

// SYSTEM_STATUS_TABLE stores 29560 which somewhere in page 57
[SYSTEM_STATUS_TABLE + 1] = 0;
ireturn;