// loadi(mem_page_no , disk_block_no);
loadi(2, 15); // exception handler routine
loadi(3, 16);
loadi(4, 17); // timer interrupt handler
loadi(5, 18);
loadi(6, 19); // disk interrupt handler
loadi(7, 20);
loadi(8, 21); // console interrupt handler
loadi(9, 22);
loadi(14, 27); // INT 6: Read
loadi(15, 28);
loadi(16, 29); // INT 7 Module
loadi(17, 30);
loadi(18, 31); // INT 8 Module
loadi(19, 32);
loadi(20, 33); // INT 9 Module
loadi(21, 34);
loadi(22, 35); // INT 10 Module
loadi(23, 36);
loadi(24, 37); // INT 11 Module
loadi(25, 38);
loadi(28, 41); // INT 13 Module
loadi(29, 42);
loadi(30, 43); // INT 14 Module
loadi(31, 44);
loadi(32, 45); // INT 15 Module
loadi(33, 46);
loadi(40, 53); // Module 0, Resource Manager
loadi(41, 54);
loadi(42, 55); // Module 1, Process Manager
loadi(43, 56);
loadi(44, 57); // Module 2, Memory Manager
loadi(45, 58);
loadi(48, 61); // Module 4, Device Manager
loadi(49, 62);
loadi(50, 63); // Module 5, Scheduler
loadi(51, 64); 
loadi(59, 3);  // inode user table
loadi(60, 4);
loadi(61, 2);
loadi(63, 13); // library 
loadi(64, 14); // these will be logical page 0 and 1
loadi(65, 7); //  init code
loadi(66, 8);

[TERMINAL_STATUS_TABLE]=0; // status = 0 for free
[DISK_STATUS_TABLE]=0;

alias i R6;
i = 0;
while (i < 128) do
    if (i < 76) then
        [MEMORY_FREE_LIST  + i] = 1;
    else
        [MEMORY_FREE_LIST + i] = 0;
    endif;
    i = i + 1;
endwhile;


[MEMORY_FREE_LIST + 76] = 1;
[MEMORY_FREE_LIST + 77] = 1;
[MEMORY_FREE_LIST + 78] = 1;
[MEMORY_FREE_LIST + 79] = 1;
[MEMORY_FREE_LIST + 80] = 1;
[MEMORY_FREE_LIST + 81] = 1;
[MEMORY_FREE_LIST + 82] = 1;
[SYSTEM_STATUS_TABLE + 0] = 1;
[SYSTEM_STATUS_TABLE + 2] = 45;
[SYSTEM_STATUS_TABLE + 3] = 0;

// Init programm
PTBR=PAGE_TABLE_BASE+20;
PTLR=10;

//Library page 0 and 1
[PTBR+0] = 63;
[PTBR+1] = "0100";
[PTBR+2] = 64;
[PTBR+3] = "0100";

//Heap page 2 and 3
[PTBR+4] = 78;
[PTBR+5] = "0110";
[PTBR+6] = 79;
[PTBR+7] = "0110";

//Code page 4, 5, 6, 7
[PTBR+8] = 65;
[PTBR+9] = "0100";
[PTBR+10] = 66;
[PTBR+11] = "0100";
[PTBR+12] = -1;
[PTBR+13] = "0000";
[PTBR+14] = -1;
[PTBR+15] = "0000";

//Stack page 8, 9
[PTBR+16] = 76;
[PTBR+17] = "0110";
[PTBR+18] = 77;
[PTBR+19] = "0110";

// disk table initialization for init
[DISK_MAP_TABLE + 10 + 2] = -1;
[DISK_MAP_TABLE + 10 + 3] = -1;
[DISK_MAP_TABLE + 10 + 4] = 7;
[DISK_MAP_TABLE + 10 + 5] = 8;
[DISK_MAP_TABLE + 10 + 6] = -1;
[DISK_MAP_TABLE + 10 + 7] = -1;
[DISK_MAP_TABLE + 10 + 8] = -1;
[DISK_MAP_TABLE + 10 + 9] = -1;


[PROCESS_TABLE + 16 + 1] = 1;
[PROCESS_TABLE + 16 + 4] = CREATED;
[PROCESS_TABLE + 16 + 11] = 80;
[PROCESS_TABLE + 16 + 12] = 0;
[PROCESS_TABLE + 16 + 13] = 8 * 512;
[PROCESS_TABLE + 16 + 14] = PAGE_TABLE_BASE + 20;
[PROCESS_TABLE + 16 + 15] = 10;
[76 * 512] = [65 * 512 + 1];


// Initialize STATE field of all other process table entries to TERMINATED
i=2;
while(i<16) do
    [PROCESS_TABLE + 16*i + 4] = TERMINATED;
    i=i+1;
endwhile;

// Initialize per process table
i=1;
while(i<9) do
    [([PROCESS_TABLE + 16 + 11] + 1) * 512 - 2 * i] = -1;
    // [((UAPNO + 1)*512) - 2*j] = -1;  uapno=80
    i=i+1;
endwhile;

// initialize the semaphore table
i=0;
while(i<32) do
    [SEMAPHORE_TABLE + 4*i]=-1;
    [SEMAPHORE_TABLE + 4*i + 1]=0;
    i=i+1;
endwhile;

return;
