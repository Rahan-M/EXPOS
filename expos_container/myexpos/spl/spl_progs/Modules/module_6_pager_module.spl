alias fno R1;
alias PID R2;

if(fno==SWAP_OUT) then
    // swap out
    alias i R3;
    i=3; // idle login and shell can't be swapped out

    alias waitPID R4;
    waitPID=-1;

    alias maxTickPID R5;
    maxTickPID=-1;
    alias maxTICK R6;
    maxTICK=-1;

    alias swapPID R7;
    swapPID=-1;

    while (i < MAX_PROC_NUM - 1) do
        if ([PROCESS_TABLE + i*16 + 6] == 0) then
            if ([PROCESS_TABLE + i*16 + 4] == WAIT_PROCESS) then
                swapPID = i;
                break;
            endif;
            if (waitPID == -1 && [PROCESS_TABLE + i*16 + 4] == WAIT_SEMAPHORE) then
                waitPID = i;
            endif;

            alias tempPCB R13;
            tempPCB = PROCESS_TABLE + i*16;
            if ([tempPCB+4] != TERMINATED && [tempPCB+4] != ALLOCATED && [tempPCB + 4] != RUNNING) then
                if ([tempPCB] > maxTICK) then
                    maxTICK = [tempPCB];
                    maxTickPID = i;
                endif;
            endif;
        endif;
        i = i + 1;
    endwhile;


    if (swapPID == -1) then
        if (waitPID != -1) then
            swapPID = waitPID;
        else
            swapPID = maxTickPID;
        endif;
    endif;

    if(swapPID==-1) then
        [SYSTEM_STATUS_TABLE+5]=0;
        R0=-1;
        return;
    endif;

    // reset tick field to 0
    [PROCESS_TABLE + 16*swapPID] = 0;
    
    alias swapPTBR R8;
    swapPTBR = [PROCESS_TABLE + 16*swapPID + 14];
    
    i=4;
    alias pageNo R9;
    while(i<20) do
        pageNo=[swapPTBR + i];
        
        // heap page or stack page
        if(i<8 || i>15) then
            // valid and non shared
            alias blockNo R10;
            if(pageNo!=-1 && [MEMORY_FREE_LIST + pageNo]==1) then
                multipush(R1, R2, R3, R4, R5, R6, R7, R8, R9);
                R1=GET_SWAP_BLOCK;
                call MOD_2;
                blockNo=R0;
                multipop(R1, R2, R3, R4, R5, R6, R7, R8, R9);

                [DISK_MAP_TABLE + 10*swapPID + i/2]=blockNo;

                multipush(R1, R2, R3, R4, R5, R6, R7, R8, R9, R10);
                R1=DISK_STORE;
                R2=SWAPPER_DAEMON; // PID
                R3=pageNo;
                R4=blockNo;
                call MOD_4;
                multipop(R1, R2, R3, R4, R5, R6, R7, R8, R9, R10);
            endif;
        endif;

        // non heap page or non shared heap page
        if(pageNo!=-1 && [MEMORY_FREE_LIST+pageNo]==1) then
            multipush(R1, R2, R3, R4, R5, R6, R7, R8, R9, R10);
                R1=RELEASE_PAGE;
                R2=pageNo;
                call MOD_2;
            multipop(R1, R2, R3, R4, R5, R6, R7, R8, R9, R10);
        endif;
        [swapPTBR + i] = -1;
        [swapPTBR + i + 1] = "0000";
        i=i+2;
    endwhile;
    
    [PROCESS_TABLE + 16*swapPID + 6]=1;
    [SYSTEM_STATUS_TABLE + 4] = [SYSTEM_STATUS_TABLE + 4] + 1;
    [SYSTEM_STATUS_TABLE + 5] = 0;
    return;
endif;

if(fno==SWAP_IN) then
    // swap in
    alias i R3;
    i=3; // idle login and shell can't be swapped out

    alias maxTICK R4;
    maxTICK=-1;

    alias swapPID R5;
    swapPID=-1;

    while(i<MAX_PROC_NUM-1) do
        if([PROCESS_TABLE + 16*i +6]==1 && [PROCESS_TABLE + 16*i + 4]==READY) then
            if([PROCESS_TABLE + 16*i]>MAX_TICK) then
                maxTICK=[PROCESS_TABLE+16*i];
                swapPID=i;
            endif;
        endif;
        i=i+1;
    endwhile;

    if(swapPID==-1) then
        [SYSTEM_STATUS_TABLE+5]=0;
        R0=-1;
        return;
    endif;

    [PROCESS_TABLE + 16*swapPID]=0;

    alias swapPTBR R6;
    swapPTBR = PAGE_TABLE_BASE + swapPID * 20;

    alias blockNo R7;
    i=2;
    while(i<10) do
        if(i<4 || i>7) then
            blockNo=[DISK_MAP_TABLE + 10*swapPID + i];
            if(blockNo!=-1) then
                alias pageNo R8;
                multipush(R1, R2, R3, R4, R5, R6, R7);
                R1=GET_FREE_PAGE;
                call MOD_2;
                pageNo=R0;
                multipop(R1, R2, R3, R4, R5, R6, R7);

                multipush(R1, R2, R3, R4, R5, R6, R7, R8);
                R1=DISK_LOAD;
                R2=PID;
                R3=pageNo;
                R4=blockNo;
                call MOD_4;
                multipop(R1, R2, R3, R4, R5, R6, R7, R8);

                multipush(R1, R2, R3, R4, R5, R6, R7, R8);
                R1=RELEASE_BLOCK;
                R3=PID;
                R2=blockNo;
                call MOD_2;
                multipop(R1, R2, R3, R4, R5, R6, R7, R8);

                [swapPTBR + 2*i]=pageNo;
                [swapPTBR + 2*i + 1]="0110";
            endif;
        else
            [swapPTBR + 2*i + 1]= "0100";
        endif;
        i=i+1;
    endwhile;

    [PROCESS_TABLE + 16*swapPID + 6]=0;
    [SYSTEM_STATUS_TABLE + 4] = [SYSTEM_STATUS_TABLE + 4] - 1;
    [SYSTEM_STATUS_TABLE + 5] = 0;
    return;
endif;
return;