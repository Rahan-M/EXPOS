alias functionNum R1;

// get pcb entry
if (functionNum == 1) then
    alias i R3;
    i = 1;
    while (i < 16) do
        if ([PROCESS_TABLE + i * 16 + 4] == TERMINATED) then
            break;
        endif;
        i = i + 1;
    endwhile;
    if (i == 16) then
        R0 = -1;
    else
        [PROCESS_TABLE + i * 16 + 4] = ALLOCATED;
        [PROCESS_TABLE + i * 16 + 1] = i;
        [PROCESS_TABLE + i * 16 + 14] = PAGE_TABLE_BASE + (20 * i);
        [PROCESS_TABLE + i * 16 + 15] = 10;
        R0 = i;
    endif;
    return;
endif;

alias currentPID R2;

alias process_table_entry R3;
process_table_entry = PROCESS_TABLE + currentPID * 16;

if(functionNum==2) then
    // free user area page
    alias UAPNO R4;
    UAPNO=[process_table_entry + 11];

    multipush(R0, R1, R2, R3, R4);
    R1=2; // Release Page
    R2=UAPNO;

    call MOD_2;
    multipop(R0, R1, R2, R3, R4);

    return;
endif;

// function number = 3 for exit proces
if(functionNum==3) then
    // Exit Process
    multipush(R0, R1, R2, R3);
    R1=4;
    call MOD_1;

    multipop(R0, R1, R2, R3);
    
    multipush(R0, R1, R2, R3);

    R1=2;
    call MOD_1;

    multipop(R0, R1, R2, R3);
    [PROCESS_TABLE + 16 * currentPID + 4] = TERMINATED;
    return;
endif;

if(functionNum==4) then
    // free page table
    // Library
    [PTBR+0]=-1;
    [PTBR+1]="0000";
    [PTBR+2]=-1;
    [PTBR+3]="0000";

    alias i R4;
    i=2;
    while(i<2*PTLR) do
        if([PTBR + i]!=-1) then
            multipush(R0, R1, R2, R3, R4);
            R1=2;
            R2=[PTBR+i];
            if(R2!=-1) then
                call MOD_2;
            endif;
            multipop(R0, R1, R2, R3, R4);
            
            [PTBR+i]=-1;
            [PTBR+i+1]="0000";
        endif;
        i=i+2;
    endwhile;

    i=2;
    while(i<10)do
        if((i<4 || i>7) && [DISK_MAP_TABLE + 10*currentPID + i]!=-1) then
            multipush(R0, R1, R2, R3, R4);
            R1=4;
            R3=currentPID;
            R2=[DISK_MAP_TABLE + 10*currentPID + i];
            
            call MOD_2;
            multipop(R0, R1, R2, R3, R4);
        endif;
        [DISK_MAP_TABLE + 10*currentPID + i]=-1;
        i=i+1;    
    endwhile;

    return;
endif;