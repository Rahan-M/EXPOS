alias functionNum R1;
alias currentPID R2;

if(functionNum!=3) then
    return;
endif;

// assign R2 to currentPID explicitly incase of erros
// acquire terminal
multipush(R1, R2, R3);
R1=8;
call MOD_0;
multipop(R1, R2, R3);
print(R3);

// release terminal
multipush(R1, R2, R3);
R1=9;
call MOD_0;
// R4=R0; // save return value if needed
multipop(R1, R2, R3);

return;