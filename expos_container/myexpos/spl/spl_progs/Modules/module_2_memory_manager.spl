alias functionNum R1;

// get free page
if(functionNum==1) then
    // final version achieved in stage 17
    [SYSTEM_STATUS_TABLE+3]=[SYSTEM_STATUS_TABLE+3]+1;
    while([SYSTEM_STATUS_TABLE+2]==0) do
        multipush(R0, R1);
        [PROCESS_TABLE + [SYSTEM_STATUS_TABLE+1]*16 + 4]=WAIT_MEM;
        call MOD_5;
        multipop(R0, R1);
    endwhile;

    [SYSTEM_STATUS_TABLE+3]=[SYSTEM_STATUS_TABLE+3]-1;
    [SYSTEM_STATUS_TABLE+2]=[SYSTEM_STATUS_TABLE+2]-1;
    
    alias i R2;
    i=76;

    while(i<128 && ([MEMORY_FREE_LIST + i] != 0)) do
        i=i+1;
    endwhile;
    [MEMORY_FREE_LIST+i]=1;
    R0=i;
    breakpoint;
    return;
endif;

// realease page function
if(functionNum==2) then
    // final version achieved in stage 17
    alias pageNo R2;
    [MEMORY_FREE_LIST + pageNo]=[MEMORY_FREE_LIST + pageNo]-1;
    if([MEMORY_FREE_LIST+pageNo]==0) then
        [SYSTEM_STATUS_TABLE+2]=[SYSTEM_STATUS_TABLE+2]+1;
    endif;

    alias i R3;
    i=0;
    while(i<16) do
        if([PROCESS_TABLE + (i*16) +4]==WAIT_MEM) then
            [PROCESS_TABLE + (i*16) + 4]=READY;
        endif;
        i=i+1;
    endwhile;
    breakpoint;
    return;
endif;

if(functionNum==3) then
    // get free block
    // we search for a free entry in disk free DISK_FREE_LIST
    // DISK_FREE_AREA gives starting block number for user blocks
    // DISK_SWAP_AREA gives starting block number of swap area
    alias i R2;
    i=DISK_FREE_AREA;
    while(i<DISK_SWAP_AREA) do
        if([DISK_FREE_LIST+i]==0) then
            [DISK_FREE_LIST + i]=1;
            break;
        endif;
        i=i+1;
    endwhile; 
    if(i==DISK_SWAP_AREA) then
        i=-1;
    endif;
    R0=i;
    return;
endif;

if(functionNum==4) then
    // release block function
    alias blockNo R2;
    alias pid R3;

    [DISK_FREE_LIST + blockNo] = [DISK_FREE_LIST + blockNo]-1;

    return;
endif;

if(functionNum==5) then
    // get code page function
    alias blockNo R2;
    alias i R3;
    alias j R4;
    alias pageNo R5;
    i=0;
    while(i<16) do
        j=4;
        while(j<8) do
            if([DISK_MAP_TABLE + 10*i + j]==blockNo) then
                pageNo = [PAGE_TABLE_BASE + 20*i + 2*j];
                if (pageNo != -1) then
                    [MEMORY_FREE_LIST + pageNo] = [MEMORY_FREE_LIST + pageNo] + 1;
                    R0 = pageNo;
                    return;
                endif;
            endif;
            j=j+1;
        endwhile;
        i=i+1;
    endwhile;

    multipush(R1, R2);
    R1=1;
    call MOD_2;
    // loads to R0
    multipop(R1, R2);
    pageNo=R0;
    multipush(R1, R2, R5);
    R1=2;
    R4=blockNo;
    R2=[SYSTEM_STATUS_TABLE+1];
    R3=pageNo;

    call MOD_4;
    multipop(R1, R2, R5);
    R0=pageNo;
    return;
endif;

if(functionNum==6) then
    alias i R2;
    i=DISK_SWAP_AREA;
    while(i<DISK_SIZE) do
        if([DISK_FREE_LIST + i]==0) then
            break;
        endif;
        i=i+1;
    endwhile;

    if(i==DISK_SIZE) then
        R0=-1;
    else
        R0=i;
        [DISK_FREE_LIST + i]=1;
    endif;
    return;
endif;