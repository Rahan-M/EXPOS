alias functionNum R1;

// Acquire buffer
if (functionNum == 1) then
    alias bufferNumber R2;
    alias currentPID R3;

    while ([BUFFER_TABLE + bufferNumber * 4 + 2] != -1) do
        [PROCESS_TABLE + currentPID * 16 + 4] = WAIT_BUFFER;
        [PROCESS_TABLE + currentPID * 16 + 5] = bufferNumber;

        multipush(R1, R2, R3);
        call SCHEDULER;
        multipop(R1, R2, R3);
    endwhile;
    [BUFFER_TABLE + bufferNumber * 4 + 2] = currentPID;
    return;
endif;

// Release buffer
if (functionNum == 2) then
    alias bufferNumber R2;
    alias currentPID R3;
    if (currentPID != [BUFFER_TABLE + bufferNumber * 4 + 2]) then
        R0 = -1;
    else
        [BUFFER_TABLE + bufferNumber * 4 + 2] = -1;
        alias i R4;
        i = 0;
        while (i < MAX_PROC_NUM) do
            if ([PROCESS_TABLE + i * 16 + 4] == WAIT_BUFFER && [PROCESS_TABLE + i * 16 + 5] == bufferNumber) then
                [PROCESS_TABLE + i * 16 + 4] = READY;
            endif;
            i = i + 1;
        endwhile;

        R0 = 0;
    endif;
    return;
endif;

if(functionNum==3) then
    alias currentPID R2;
    // acquire disk function final version
    alias process_table_entry R3;
    process_table_entry = PROCESS_TABLE + currentPID * 16;

    while([DISK_STATUS_TABLE]==1) do
        [process_table_entry+4]=WAIT_DISK;
        multipush(R1, R2, R3);
        call MOD_5;
        multipop(R1, R2, R3);
    endwhile;

    [DISK_STATUS_TABLE]=1;
    [DISK_STATUS_TABLE+4]=currentPID;
    return;
endif;

if (functionNum == 4) then // acquire inode
    alias inodeNumber R2;
    alias currentPID R3;

    while ([FILE_STATUS_TABLE + inodeNumber * 4 + 0] != -1) do
        [PROCESS_TABLE + currentPID * 16 + 4] = WAIT_FILE;
        [PROCESS_TABLE + currentPID * 16 + 5] = inodeNumber;
        multipush(R1, R2, R3);
        call MOD_5;
        multipop(R1, R2, R3);
    endwhile;

    // file delete check
    if ([INODE_TABLE + inodeNumber * 16 + 1] == -1) then
        // file deleted by the time we acquired inode
        R0 = -1;
    else 
        [FILE_STATUS_TABLE + inodeNumber * 4 + 0] = currentPID;
        R0 = 0;
    endif;
    return;
endif;

if (functionNum == 5) then // release inode
    alias inodeNumber R2;
    alias currentPID R3;

    if ([FILE_STATUS_TABLE + inodeNumber * 4 + 0] == currentPID) then
        [FILE_STATUS_TABLE + inodeNumber * 4 + 0] = -1;
        alias i R4;
        i = 0;
        while (i < 16) do
            if ([PROCESS_TABLE + i * 16 + 4] == WAIT_FILE && [PROCESS_TABLE + i * 16 + 5] == inodeNumber) then
                [PROCESS_TABLE + i * 16 + 4] = READY;
            endif;
            i = i + 1;
        endwhile;
        R0 = 0;
    else
        R0 = -1;
    endif;
    return;
endif;

if(functionNum==6) then
    alias currentPID R2;
    alias i R3;
    i=0;
    while(i<32) do
        if([SEMAPHORE_TABLE + 4*i + 1]==0) then
            break;
        endif;
        i=i+1;
    endwhile;

    if(i==32) then
        R0=-1;
        return;
    endif;

    [SEMAPHORE_TABLE + 4*i]=-1;
    [SEMAPHORE_TABLE + 4*i + 1]=1;

    R0=i;
    return;
endif;

if(functionNum==7) then
    alias semID R2;
    alias pid R3;

    if([SEMAPHORE_TABLE+4*semID] == pid)then
        [SEMAPHORE_TABLE + 4*semID]=-1;
        alias i R4;
        i=0;
        while(i<16) do
            if([PROCESS_TABLE + 16*i +4] == WAIT_SEMAPHORE && [PROCESS_TABLE+16*i+5]==semID) then
                [PROCESS_TABLE+ 16*i+4]=READY;
                [PROCESS_TABLE+ 16*i+5]=-1;
            endif;
            i=i+1;
        endwhile;
    endif;
    [SEMAPHORE_TABLE + 4*semID + 1]=[SEMAPHORE_TABLE + 4*semID + 1]-1;
    R0=0;
    return;
endif;

if(functionNum==8) then
    alias currentPID R2;
    alias process_table_entry R3;
    process_table_entry = PROCESS_TABLE + currentPID * 16;

    if([TERMINAL_STATUS_TABLE]==1) then
        [process_table_entry + 4] = WAIT_TERMINAL;
        multipush(R1, R2, R3);

        call MOD_5;

        multipop(R1, R2, R3);
    endif;
    [TERMINAL_STATUS_TABLE + 0]=1;
    [TERMINAL_STATUS_TABLE + 1]=currentPID;
//    breakpoint;
    return;
// Note that this code = will be executed only after the scheduler 
// schedules the process again, which in turn occurs only after the
// terminal was released by the holding process by invoking the release
// terminal function.
endif;

if(functionNum==9) then
    alias currentPID R2;
    alias process_table_entry R3;
    process_table_entry = PROCESS_TABLE + currentPID * 16;

    if([TERMINAL_STATUS_TABLE+1]!=currentPID) then
        R0=-1;
        return;
    endif;
    [TERMINAL_STATUS_TABLE+0]=0;
    alias i R4;
    i=0;
    while(i<16) do
        if([PROCESS_TABLE + 16*i + 4]==WAIT_TERMINAL) then
            [PROCESS_TABLE + 16*i + 4]= READY;
        endif;
        i=i+1;
    endwhile;
    R0=0;
//    breakpoint;
    return;
endif;
return;