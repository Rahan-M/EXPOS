loadi(63, 13); // load library code from disk, loaded to disk during startup
loadi(64, 14);// these will be logical page 0 and 1
loadi(65, 7); // 65 and 66 stores init code
loadi(66, 8);
loadi(22, 35); // INT 10 Module
loadi(23, 36);
loadi(2, 15); // exception handler routine
loadi(3, 16);

PTBR=PAGE_TABLE_BASE;
PTLR=10;

//Library
[PTBR+0] = 63;
[PTBR+1] = "0100";
[PTBR+2] = 64;
[PTBR+3] = "0100";

//Heap
[PTBR+4] = 78;
[PTBR+5] = "0110";
[PTBR+6] = 79;
[PTBR+7] = "0110";

//Code
[PTBR+8] = 65;
[PTBR+9] = "0100";
[PTBR+10] = 66;
[PTBR+11] = "0100";
[PTBR+12] = -1;
[PTBR+13] = "0000";
[PTBR+14] = -1;
[PTBR+15] = "0000";

//Stack
[PTBR+16] = 76;
[PTBR+17] = "0110";
[PTBR+18] = 77;
[PTBR+19] = "0110";

SP=8*512;
[76*512]=[65*512 + 1];
ireturn;