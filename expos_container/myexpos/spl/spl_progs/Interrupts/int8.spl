[PROCESS_TABLE + [SYSTEM_STATUS_TABLE+1]*16 + 9] = 8;

alias userSP R0; 
userSP = SP; 

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13]=SP;
SP=[PROCESS_TABLE + [SYSTEM_STATUS_TABLE+1] * 16 + 11] * 512 - 1;

multipush(R0);
// get_pcb_entry
R1=1;
call MOD_1;

// R0 now contains index of a free PCB, i.e PID of the child.
// R0 contains -1 if no space exists for a process

alias newPID R2;
alias oldPID R3;
newPID=R0;
oldPID=[SYSTEM_STATUS_TABLE+1];
multipop(R0);

if (newPID == -1) then
    alias physicalAddrRetVal R5;
    physicalAddrRetVal = ([PTBR + 2 * ((userSP - 1) / 512)] * 512) + ((userSP - 1) % 512);
    [physicalAddrRetVal] = -1;
    SP=[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13];
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;
    ireturn;
endif;

// if heap pages for parent are not allocated
if(PTBR + 4 == -1) then
    multipush(R0, R1, R2, R3, R4);
    R1=1;
    call MOD_1;
    multipop(R0, R1, R2, R3, R4);

    [PTBR + 4]=R0;
    [PTBR + 5]="1110";


    multipush(R0, R1, R2, R3, R4);
    R1=1;
    call MOD_1;
    multipop(R0, R1, R2, R3, R4);

    [PTBR + 6]=R0;
    [PTBR + 7]="1110";
endif;


alias newPTBR R4;
newPTBR = PAGE_TABLE_BASE + 20 * newPID;

multipush(R0, R1, R2, R3, R4);

R1 = 1;
call MOD_2;
[newPTBR + 16] = R0;
[newPTBR + 17] = [PTBR + 17];

R1 = 1;
call MOD_2;
[newPTBR + 18] = R0;
[newPTBR + 19] = [PTBR + 19];

R1=1;
call MOD_2;

alias newUAP R5;
newUAP=R0;
multipop(R0, R1, R2, R3, R4);

[PROCESS_TABLE + newPID*16 + 3] = [PROCESS_TABLE + oldPID*16 + 3];
[PROCESS_TABLE + newPID*16 + 6] = [PROCESS_TABLE + oldPID*16 + 6];
[PROCESS_TABLE + newPID*16 + 7] = [PROCESS_TABLE + oldPID*16 + 7];
[PROCESS_TABLE + newPID*16 + 10] = [PROCESS_TABLE + oldPID*16 + 10];
[PROCESS_TABLE + newPID*16 + 13] = [PROCESS_TABLE + oldPID*16 + 13];

[PROCESS_TABLE + newPID*16 + 0] = 0;
[PROCESS_TABLE + newPID*16 + 2] = oldPID;
[PROCESS_TABLE + newPID*16 + 4] = CREATED;
[PROCESS_TABLE + newPID*16 + 9] = 0;
[PROCESS_TABLE + newPID*16 + 11] = newUAP;
[PROCESS_TABLE + newPID*16 + 12] = 0;


// initialization per process resourse table child
alias oldUAP R6;
alias i R7;
oldUAP=[PROCESS_TABLE + [SYSTEM_STATUS_TABLE+1]*16 + 11];
i=1;

while(i<17) do
    [(newUAP + 1)*512 - i]=[(oldUAP + 1)*512 - i];
    i=i+1;
endwhile;

// disk map table for child
i = 0;
while (i < 10) do
    [DISK_MAP_TABLE + 10 * newPID + i] = [DISK_MAP_TABLE + [SYSTEM_STATUS_TABLE + 1] * 10 + i];
    i = i + 1;
endwhile;

// page table entries
i = 0;
while (i < 16) do
    [newPTBR + i] = [PTBR + i];
    [newPTBR + i + 1] = [PTBR + i + 1];
    if ([newPTBR + i] != -1) then
        [MEMORY_FREE_LIST + [newPTBR + i]] = [MEMORY_FREE_LIST + [newPTBR + i]] + 1;
    endif;
    i = i + 2;
endwhile;

// copy user stack contents
alias oldStack R8;
alias newStack R9;

oldStack = [PTBR + 16];
newStack = [newPTBR + 16];
i = 0;
while (i < 512) do
    [newStack * 512 + i] = [oldStack * 512 + i];
    i = i + 1;
endwhile;

oldStack = [PTBR + 18];
newStack = [newPTBR + 18];
i = 0;
while (i < 512) do
    [newStack * 512 + i] = [oldStack * 512 + i];
    i = i + 1;
endwhile;

[[PROCESS_TABLE + newPID * 16 + 11] * 512] = BP;
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

// return value
[[PTBR + 2 * ((userSP - 1) / 512)] * 512 + (userSP - 1) % 512] = newPID;
[[newPTBR + 2 * ((userSP - 1) / 512)] * 512 + (userSP - 1) % 512] = 0;

SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13];

ireturn;