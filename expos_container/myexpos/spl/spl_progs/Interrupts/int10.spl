alias currentPID R0;
currentPID = [SYSTEM_STATUS_TABLE+1];

alias process_table_entry R1;
process_table_entry = PROCESS_TABLE + currentPID * 16;

[process_table_entry + 4] = TERMINATED;
alias i R2;
i=1;
// break when proces status !=TERMINATED
while((i<16) && ([PROCESS_TABLE + 16*i + 4] == TERMINATED))do
    i=i+1;
endwhile;
if(i>=16) then
    halt;
endif;

call MOD_5; 
// The return within context switch module will take it back to 
// the address store on top of the kernel stack of new process
// the new process will never be this so it never gets executed again