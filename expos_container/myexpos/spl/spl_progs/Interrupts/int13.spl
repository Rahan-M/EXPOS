// Semget (17) and Semrelease (18)
alias userSP R0;
userSP = SP;

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13] = SP;
SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512 - 1;

alias sysCallNumber R1;
sysCallNumber = [[PTBR + 2 * ((userSP - 5) / 512)] * 512 + ((userSP - 5) % 512)];

alias currPID R2;
currPID=[SYSTEM_STATUS_TABLE+1];
alias ptab R3;
ptab= PROCESS_TABLE + currPID*16;


[ptab + 9] = sysCallNumber;
if(sysCallNumber==17) then
    // Semget
    alias i R4;
    alias pprTab R5;
    i=0;
    pprTab = [ptab + 11] *512 + RESOURCE_TABLE_OFFSET;  // 496 = 512 - 16
    while(i<16) do
        if([pprTab + 2*i]==-1) then
            break;
        endif;
        i=i+1;
    endwhile;

    if(i==16) then
        [[PTBR + 2*((userSP-1)/512)] * 512 + ((userSP-1) % 512)]=-1;
        SP = userSP;
        [ptab + 9] = 0;
        ireturn;
    endif;

    pprTab = pprTab+2*i;
    [pprTab]=SEMAPHORE;

    multipush(R0, R1, R2, R3, R4, R5);
    R1=6;
    R2=currPID;
    call MOD_0;
    alias j R6;
    j=R0;
    multipop(R0, R1, R2, R3, R4, R5);

    if(j==-1) then
        [[PTBR + 2*((userSP-1)/512)] * 512 + ((userSP-1) % 512)]=-2;
        SP = userSP;
        [ptab + 9] = 0;
        ireturn;
    endif;

    [pprTab+1]=j;
    
    [[PTBR + 2*((userSP-1)/512)] * 512 + ((userSP-1) % 512)]=i;
    SP = userSP;
    [ptab + 9] = 0;
    ireturn;
endif;

if(sysCallNumber==18) then
    // Semrelease
    alias semID R4;
    semID = [[PTBR + 2 * ((userSP - 4) / 512)] * 512 + ((userSP - 4) % 512)];
    alias pprTab R5;
    pprTab = ([ptab + 11] + 1)*512 - 16 + 2*semID;

    if(semID<0 || semID>7 || [pprTab + 1]!=1) then
        [[PTBR + 2*((userSP-1)/512)] * 512 + ((userSP-1) % 512)]=-1;
        SP = userSP;
        [ptab + 9] = 0;
        ireturn;
    endif;

    
    multipush(R0, R1, R2, R3, R4);
        R1=7;
        R3=currPID;
        R2=[pprTab+1];
        call MOD_0;
    multipop(R0, R1, R2, R3, R4);

    [pprTab]=-1; 
    [pprTab+1]=-1;

    [[PTBR + 2*((userSP-1)/512)] * 512 + ((userSP-1) % 512)]=0;
    SP = userSP;
    [ptab + 9] = 0;
    ireturn;
endif;

SP = userSP;
[ptab + 9] = 0;
ireturn;

