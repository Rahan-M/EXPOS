[PROCESS_TABLE + [SYSTEM_STATUS_TABLE+1]*16 + 9] = 8;

alias userSP R0; 
userSP = SP; 

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13]=SP;
SP=[PROCESS_TABLE + [SYSTEM_STATUS_TABLE+1] * 16 + 11] * 512 - 1;

multipush(R0);
// get_pcb_entry
R1=1;
call MOD_1;

// R0 now contains index of a free PCB, i.e PID of the child.
// R0 contains -1 if no space exists for a process

alias newPID R2;
alias oldPID R3;
newPID=R0;
oldPID=[SYSTEM_STATUS_TABLE+1];
multipop(R0);

if(newPID==-1) then
    alias physicalAddrRetVal R5;
    physicalAddrRetVal = ([PTBR + 2 * ((userSP - 1) / 512)] * 512) + ((userSP - 1) % 512);
    [physicalAddrRetVal] = -1;
    SP=[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13];
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;
    ireturn;
endif;



if(PTBR + 4 == -1) then
    multipush(R1, R2, R3, R4);
    R1=1;
    call MOD_1;
    multipop(R1, R2, R3, R4);

    [PTBR + 4]=R0;
    [PTBR + 5]="1110";


    multipush(R1, R2, R3, R4);
    R1=1;
    call MOD_1;
    multipop(R1, R2, R3, R4);

    [PTBR + 6]=R0;
    [PTBR + 7]="1110";
endif;

// stack pages of child process
multipush(R1, R2, R3, R4);
R1=1;
call MOD_2;
multipop(R1, R2, R3, R4);

[PAGE_TABLE_BASE + newPID*20 + 16] = R0;
[PAGE_TABLE_BASE + newPID*20 + 17] = [PTBR + 17];

multipush(R1, R2, R3, R4);
R1=1;
call MOD_2;
multipop(R1, R2, R3, R4);

[PAGE_TABLE_BASE + newPID*20 + 18] = R0;
[PAGE_TABLE_BASE + newPID*20 + 19] = [PTBR + 19];

multipush(R1, R2, R3, R4);
R1=1;
call MOD_2;
multipop(R1, R2, R3, R4);

alias newUAP R5;
newUAP=R0;


[PROCESS_TABLE + newPID*16 + 3] = [PROCESS_TABLE + oldPID*16 + 3];
[PROCESS_TABLE + newPID*16 + 6] = [PROCESS_TABLE + oldPID*16 + 6];
[PROCESS_TABLE + newPID*16 + 7] = [PROCESS_TABLE + oldPID*16 + 7];
[PROCESS_TABLE + newPID*16 + 10] = [PROCESS_TABLE + oldPID*16 + 10];
[PROCESS_TABLE + newPID*16 + 13] = [PROCESS_TABLE + oldPID*16 + 13];
// the UPTRs of the two processes will have the same logical addresses 
// but they will be mapped to different physical addresses
[PROCESS_TABLE + newPID*16 + 0] = 0;
[PROCESS_TABLE + newPID*16 + 2] = oldPID;
[PROCESS_TABLE + newPID*16 + 4] = CREATED;
[PROCESS_TABLE + newPID*16 + 9] = 0;
[PROCESS_TABLE + newPID*16 + 11] = newUAP;
[PROCESS_TABLE + newPID*16 + 12] = 0;

alias oldUAP R6;
alias i R7;
oldUAP=[PROCESS_TABLE + [SYSTEM_STATUS_TABLE+1]*16 + 11];
i=1;

while(i<17) do
    [(newUAP + 1)*512 - i]=[(oldUAP + 1)*512 - i];
    i=i+1;
endwhile;

i=2;
while(i<8) do
    [DISK_MAP_TABLE + newPID*10 + i]=[DISK_MAP_TABLE + oldPID*10 + i];
    i=i+1;
endwhile;
[DISK_MAP_TABLE + newPID*10 + 8]=-1;
[DISK_MAP_TABLE + newPID*10 + 9]=-1;

i=0;
while(i<16) do
    [PAGE_TABLE_BASE + 20*newPID + i]=[PTBR + i];
    [MEMORY_FREE_LIST + [PTBR+i]]=[MEMORY_FREE_LIST + [PTBR+i]]+1;
    i=i+1;
endwhile;

alias oldStack R8;
alias newStack R9;
oldStack=[PTBR + 8];
newStack=[PAGE_TABLE_BASE + 20*newPID + 8];

while(i<512) do
    [newStack + i]=[oldStack + i];
    i=i+1;
endwhile;

[newUAP * 512]=BP;
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

alias newPTBR R8;
newPTBR=PAGE_TABLE_BASE + 20*newPID;
// return value
[[PTBR + 2 * ((userSP - 1) / 512)] * 512 + (userSP - 1) % 512] = newPID;
[[newPTBR + 2 * ((userSP - 1) / 512)] * 512 + (userSP - 1) % 512] = 0;

SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13];

ireturn;