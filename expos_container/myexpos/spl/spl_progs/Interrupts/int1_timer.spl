// ENTRY
// SWITCH FROM USER STACK TO KERNEL STACK OF CURRENT PROCESS AND SAVE THE REGISTER CONTEXT USING BACKUP
// index 1 of system status table stores PID
// 13th index of process table stores user stack pointer i.e UPTR
// breakpoint;
[PROCESS_TABLE + ( [SYSTEM_STATUS_TABLE + 1] * 16) + 13] = SP;
// Setting SP to UArea Page number * 512 - 1
SP = [PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1] * 16) + 11] * 512 - 1;

// The scheduler assumes that the timer handler would have saved the 
// user context of the current process (values of R0-R19 and BP registers) 
// into the kernel stack before the call. 
backup;

// However, the machine's SP register will still point to the top of the 
// kernel stack of the currently running process at the time of the call.

if([SYSTEM_STATUS_TABLE+5]!=0) then
    // swapping to be done or is ongoing
    if([SYSTEM_STATUS_TABLE+1]==15) then
        // current process is the swapper daemon
        R1=[SYSTEM_STATUS_TABLE+5];
        R2=[SYSTEM_STATUS_TABLE+1];
        call MOD_6;
    endif;
else
    if([SYSTEM_STATUS_TABLE+2]<MEM_LOW) then
        [SYSTEM_STATUS_TABLE+5] = SWAP_OUT;
    else
        if([SYSTEM_STATUS_TABLE + 4]>0) then
            if([SYSTEM_STATUS_TABLE+2]>MEM_HIGH) then
                [SYSTEM_STATUS_TABLE+5]=SWAP_IN;
            else
                alias i R4;
                i=0;
                while(i<MAX_PROC_NUM) do
                    if([PROCESS_TABLE + i*16 + 6]== 1 && [PROCESS_TABLE + i*16]>MAX_TICK) then
                        [SYSTEM_STATUS_TABLE+5]=SWAP_IN;
                        break;
                    endif;
                    i=i+1;
                endwhile;
            endif;
        endif;
    endif;
endif;

// mod5 also assumes that the state of the process has been changed to READY
[PROCESS_TABLE + ( [SYSTEM_STATUS_TABLE + 1] * 16) + 4] = READY; // should come after the above stuff

// increment tick for all non terminated processes
alias i R6;
i=0;
while(i<16) do
    if([PROCESS_TABLE + 16*i + 4] != TERMINATED) then
        [PROCESS_TABLE + 16*i] = [PROCESS_TABLE + 16*i]+1;
    endif;
    i=i+1;
endwhile;

call MOD_5;

// EXIT
restore;
// reset SP from UPTR
SP=[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE+1])*16 + 13];
[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE+1])*16 + 9]=0;
// breakpoint;
ireturn;