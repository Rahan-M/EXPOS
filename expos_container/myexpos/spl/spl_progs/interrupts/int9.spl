[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1]*16 + 9]=9;
// 9 is the system call number for exec

alias userSP R0;
userSP = SP;

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13]=SP;
SP=[PROCESS_TABLE + [SYSTEM_STATUS_TABLE+1] * 16 + 11] * 512 - 1;

// find file descriptor
//userSP-5=sys call number userSP-4=arg1, -3=arg2, -2=arg3, -1=retval, -0=IP+2
// translate userSP-4
alias physicalPageNum R1;
alias offset R2;
alias fileNamePhysicalAddr R3;
physicalPageNum = [PTBR + 2 * ((userSP - 4)/ 512)];
offset = (userSP - 4) % 512;
fileNamePhysicalAddr = (physicalPageNum * 512) + offset;
alias fileName R4;
fileName=[fileNamePhysicalAddr];

alias inodeEntry R6;
inodeEntry=0;
while(inodeEntry<MAX_FILE_NUM ) do
    if (fileName == [INODE_TABLE + inodeEntry * 16 + 1]) then
        if ([INODE_TABLE + inodeEntry * 16] == EXEC) then
            break;
        endif;
    endif;
    inodeEntry = inodeEntry + 1;
endwhile;


// NOT FOUND
if(inodeEntry==60) then
    alias physicalAddrRetVal R7;
    physicalAddrRetVal = ([PTBR + 2 * ((userSP - 1) / 512)] * 512) + ((userSP - 1) % 512);
    [physicalAddrRetVal] = -1;
    SP=userSP;
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;
    ireturn;
endif;


multipush(R0,R1,R2,R3,R4,R5,R6);
R1=3; // Function number for exit process
R2=[SYSTEM_STATUS_TABLE+1];

call MOD_1;

multipop(R0,R1,R2,R3,R4,R5,R6);

alias UAPNO R7;
UAPNO=[PROCESS_TABLE + [SYSTEM_STATUS_TABLE+1]*16 + 11];

[MEMORY_FREE_LIST + UAPNO] = [MEMORY_FREE_LIST + UAPNO] + 1; // increment mem free list of uapno
[SYSTEM_STATUS_TABLE + 2]= [SYSTEM_STATUS_TABLE + 2] -1; // decrement mem free count

SP=UAPNO*512-1;

// New process uses the PID of the terminated process
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE+1]*16 + 4] = RUNNING;
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE+1]*16 + 7] = inodeEntry;

// Library
[PTBR]=63;
[PTBR+1]="0100";
[PTBR+2]=64;
[PTBR+3]="0100";

multipush(R0, R1, R2, R3, R4, R5, R6, R7);

// Heap
[PTBR + 4]=-1;
[PTBR + 5]= "0000";
[PTBR + 6] = -1;
[PTBR + 7] = "0000";

// Stack
R1 = 1;
call MOD_2;
[PTBR + 16] = R0;
[PTBR + 17] = "0110";

R1 = 1;
call MOD_2;
[PTBR + 18] = R0;
[PTBR + 19] = "0110";

multipop(R0, R1, R2, R3, R4, R5, R6, R7);

// Invalidate code pages 2, 3 and 4
alias i R8;
i = 1;
while (i < 4) do
    [PTBR + 8 + 2 * i] = -1;
    [PTBR + 9 + 2 * i] = "0000";
    i = i + 1;
endwhile;

// DISK_MAP_TABLE
alias numBlocks R9;
alias currentPID R10;
numBlocks=(([INODE_TABLE + 16* inodeEntry + 2]-1)/512)+1;
currentPID=[SYSTEM_STATUS_TABLE+1];

i=2;
while(i<10) do
    if(i==2 || i==3) then
        [DISK_MAP_TABLE+10*currentPID+i]=-1;
    endif;
    if(i==8 || i==9) then
        [DISK_MAP_TABLE+10*currentPID+i]=-1;
    endif;
    if(i>3 && i<8) then
        [DISK_MAP_TABLE + (10* currentPID) + i]=[INODE_TABLE + 16*inodeEntry + i + 4];
    endif;
    i=i+1;
endwhile;


multipush(R0, R1, R2, R3, R4, R5, R6, R7, R8, R9, R10);

R1 = 5;
R2 = [INODE_TABLE + inodeEntry * 16 + 8];
call MOD_2; // I forgot this earlier
[PTBR + 8] = R0;
[PTBR + 9] = "0100";

multipop(R0, R1, R2, R3, R4, R5, R6, R7, R8, R9, R10);

// Initialization of per process table
i=1;
while(i<9) do
    [([PROCESS_TABLE + [SYSTEM_STATUS_TABLE+1]*16 + 11] + 1) *512 - (2*i)] = -1;
    i=i+1;
    // [((UAPNO + 1)*512) - 2*i] = -1;
    // Last 16 words of the UAPNO is reserved for this
endwhile;


[[PTBR + 16]*512] = [[PTBR+8]*512 + 1];
SP=8*512; // logical address
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE+1]*16 + 9]=0;
ireturn;
