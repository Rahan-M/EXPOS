[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 7;
// index 9 of PROCESS_TABLE stores mode flag that is set to current system 
// call no which is 7 for read
alias userSP R0;
userSP = SP;

// save SP to UPTR
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13] = SP;
// set SP to beginning of Kernel stack
SP = [PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1] * 16) + 11] * 512 - 1;

// translate userSP-4
alias physicalPageNum R1;
alias offset R2;
physicalPageNum = [PTBR + 2 * (( userSP - 4 )/512)];
offset = (userSP - 4) % 512;
alias fileDescriptor R3;
fileDescriptor=[physicalPageNum * 512 + offset];

alias retAddr R4;
retAddr = [PTBR + 2*((userSP-1)/512)] * 512 + (userSP-1)%512;

if(fileDescriptor==-1)
then
    alias wordAddr R5;
    wordAddr = [[PTBR + 2 * ((userSP - 3) / 512)] * 512 + ((userSP - 3) % 512)];
    multipush(R0, R1, R2, R3, R4, R5);
    R1=4; // function number of terminal read
    R2=[SYSTEM_STATUS_TABLE+1];
    R3=wordAddr;

    call MOD_4;

    multipop(R0, R1, R2, R3, R4, R5);
    [retAddr]=0;
else
    [retAddr]=-1;
endif;

SP=userSP;
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;
ireturn;